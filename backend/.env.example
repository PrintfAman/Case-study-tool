# ============================================================================
# BACKEND ENVIRONMENT TEMPLATE
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:
#     backend> copy .env.example .env        (Windows cmd)
#     backend> Copy-Item .env.example .env   (PowerShell)
#
# `.env` is git-ignored - it holds secrets and is never committed.
# `.env.example` IS committed, so it documents which variables exist.
#
# Every variable below is optional in Phase 1 because config/env.ts defines
# safe defaults. Values are still validated with Zod at startup, so an invalid
# value fails fast with a clear message instead of a confusing runtime error.
# ============================================================================

# ---------------------------------------------------------------------------
# ACTIVE IN PHASE 1
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Port the API listens on. The frontend expects 5000.
PORT=5000

# The single origin allowed to call this API from a browser.
# Must match the URL printed by `npm run dev` in the frontend.
CORS_ORIGIN=http://localhost:5173

# Version prefix for all business endpoints.
API_PREFIX=/api/v1

# Persistent local SQLite database
DATABASE_PATH=./storage/case-study-tool.sqlite

# Authentication session signing
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_DAYS=7

# Optional GitHub API authentication
GITHUB_TOKEN=

# Optional Groq AI synthesis
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=8000

# Optional competitor research
TAVILY_API_KEY=

# Generated PDF storage
REPORT_STORAGE_DIR=./storage/reports

# ---------------------------------------------------------------------------
# INTRODUCED IN LATER PHASES - keep commented out until then.
# Uncommenting now does nothing, because config/env.ts only reads declared keys.
# ---------------------------------------------------------------------------

